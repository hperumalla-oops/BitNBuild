# Copy to .env and fill in. No quotes needed, and no space before the "=".

# OpenAI — chat completions and the embeddings that back the zoning RAG.
# Server-side only; this must never reach the browser.
OPENAI_API=sk-...

SUPABASE_URL=https://xxxx.supabase.co

# Service role. Bypasses row level security, so server-side only:
# the parsers, the loader and the chat agent use it.
SUPABASE_SECRET_KEY=service-role-key-goes-here

# Publishable (anon) key. Public by design — make_web_config.py writes it into
# web/config.js so the browser can read the map data. RLS is what protects it.
SUPABASE_PUBLISHABLE_KEY=anon-key-goes-here

# Tavily — the chat agent's web_search tool. Server-side only.
# Without it the chat still works; web search reports itself as unavailable.
TAVILY_API_KEY=tvly-...
